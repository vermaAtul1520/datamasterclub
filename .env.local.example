# URL of the Google Apps Script Web App that appends signups to a Google Sheet.
# The API route at app/api/subscribe/route.ts POSTs { fullName, email, pdf, note,
# source, utm_source, utm_medium, utm_campaign, referrer, landingPath, timestamp }
# to this URL as JSON. Add sheet columns for the attribution fields to keep them. Leave unset locally to see the "not connected yet" state.
LEADS_WEBHOOK_URL=

# Public invite link shown on the post-signup success screen (WhatsApp group, etc).
# Safe to leave as "#" until a final community platform is chosen.
NEXT_PUBLIC_COMMUNITY_INVITE_URL=#

# The site's real, publicly reachable URL (Vercel URL or final domain).
# Used to build absolute OpenGraph/Twitter share-card URLs, and as the link
# inside learners' LinkedIn shout-out posts — must be the real domain in prod. Safe to leave
# as localhost while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
