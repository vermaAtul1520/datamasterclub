# URL of the Google Apps Script Web App that appends signups to a Google Sheet.
# The API route at app/api/subscribe/route.ts POSTs { email, source, utm_*, timestamp }
# to this URL as JSON. Leave unset locally to see the "not connected yet" state.
LEADS_WEBHOOK_URL=

# Public invite link shown on the post-signup success screen (WhatsApp group, etc).
# Safe to leave as "#" until a final community platform is chosen.
NEXT_PUBLIC_COMMUNITY_INVITE_URL=#
